{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RazorFramework Feature List",
  "type": "object",
  "additionalProperties": false,
  "required": ["features"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "dependencies",
          "status",
          "doneCriteria",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^feat-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^feat-[0-9]{3}$"
            }
          },
          "status": {
            "type": "string",
            "enum": ["not-started", "in-progress", "blocked", "done"]
          },
          "doneCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
